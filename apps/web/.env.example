# Public base URL of the Cloudflare Worker API
NEXT_PUBLIC_API_URL=https://api.ranjitdas2048.workers.dev

# Server-side HMAC key used to sign short-lived worker API tokens.
# Generate one with: openssl rand -hex 32
# It must match the WORKER_API_SECRET secret on the api worker:
#   cd apps/pdf-worker/src/workers/api && npx wrangler secret put WORKER_API_SECRET
WORKER_API_SECRET=replace-with-the-same-random-value
